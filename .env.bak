# Copy to ".env" for running on your own PC (never upload .env to GitHub).
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# ADMIN_PASSWORD=only-used-when-the-database-is-brand-new

